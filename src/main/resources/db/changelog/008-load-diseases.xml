<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">


<changeSet id="008-load-diseases" author="developer">
    <!-- CSV'den okuyup diseases tablosuna basıyoruz -->
    <loadData tableName="diseases" file="db/changelog/data/diseases.csv">
        <column name="name" type="STRING"/>
        <column name="personal_factor" type="NUMERIC"/>
        <column name="family_factor" type="NUMERIC"/>
    </loadData>
</changeSet>
</databaseChangeLog>