<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- 1. BMI Kategorileri Tablosu -->
    <changeSet id="create-bmi-categories-table" author="developer">
        <createTable tableName="bmi_categories">
            <column name="id" type="INT">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="code" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="definition" type="VARCHAR(255)"/>
            <column name="min_bmi" type="NUMERIC"/>
            <column name="max_bmi" type="NUMERIC"/>
        </createTable>

        <addForeignKeyConstraint
                baseTableName="bmi_categories"
                baseColumnNames="code"
                constraintName="fk_bmi_risk_parameter"
                referencedTableName="risk_parameters"
                referencedColumnNames="code"/>
    </changeSet>

    <!-- 2. Meslekler Tablosu -->
    <changeSet id="create-occupations-table" author="developer">
        <createTable tableName="occupations">
            <column name="id" type="INT">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="occupation_name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="code" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint
                baseTableName="occupations"
                baseColumnNames="code"
                constraintName="fk_occupation_risk_parameter"
                referencedTableName="risk_parameters"
                referencedColumnNames="code"/>
    </changeSet>

    <!-- 3. Kişisel Hastalıklar Tablosu -->
    <changeSet id="create-personal-diseases-table" author="developer">
        <createTable tableName="personal_diseases">
            <column name="id" type="INT">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="disease_name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="code" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint
                baseTableName="personal_diseases"
                baseColumnNames="code"
                constraintName="fk_disease_risk_parameter"
                referencedTableName="risk_parameters"
                referencedColumnNames="code"/>
    </changeSet>

</databaseChangeLog>